<Window xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:QsppManager.Desktop.ViewModels"
             xmlns:local="clr-namespace:QsppManager.Desktop"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
             x:Class="QsppManager.Desktop.MainWindow"
             Title="Hugh's QSPP Manager"
             Width="1280" Height="800" MinWidth="940" MinHeight="580"
             ExtendClientAreaToDecorationsHint="True"
             ExtendClientAreaTitleBarHeightHint="-1"
             Background="{DynamicResource Brush.Paper}"
             AutomationProperties.AutomationId="QsppMainWindow">

  <Window.Resources>
    <DataTemplate x:Key="PaletteResultTemplate">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,6">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalAlignment="Center">
          <Border Padding="6,2" CornerRadius="4" Background="{DynamicResource Brush.Sage}">
            <TextBlock FontSize="10" FontWeight="SemiBold" Text="{Binding Kind}" Foreground="{DynamicResource Brush.Muted}"/>
          </Border>
          <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Grid>
        <TextBlock Grid.Column="1" Text="{Binding Meta}" Classes="monoSm" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" MaxWidth="150"/>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Grid x:Name="RootGrid" ColumnDefinitions="Auto,*">
    <!-- ============ Sidebar: full height, one surface with the page (premium-polish 3.2/3.3) ============ -->
    <Border x:Name="Sidebar" Width="{Binding SidebarWidth}"
            Background="{DynamicResource Brush.Sidebar}"
            BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,1,0"
            AutomationProperties.AutomationId="Sidebar"
            IsVisible="{Binding SignedIn}">
      <!-- One window, one surface: opaque sidebar paper; no acrylic (3.1). -->
      <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel x:Name="SidebarHeader" Margin="18,40,16,4" Height="54" IsVisible="{Binding SidebarExpanded}">
          <!-- 3F #2: identical block everywhere — up to two lines, then 'QSPP Folio' underneath. -->
          <TextBlock Classes="headline" Text="{Binding PharmacyName}" TextWrapping="Wrap" MaxLines="2"
                     VerticalAlignment="Top"/>
          <TextBlock Classes="footnote" Text="QSPP Folio"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">   <!-- 3F #2: Disabled, not Hidden — Hidden grants infinite width, so the header name never wraps -->
          <ItemsControl x:Name="NavGroupsHost" ItemsSource="{Binding NavGroups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="8,8,8,12" Spacing="1">
                  <TextBlock Classes="eyebrow" Text="{Binding Label}" Margin="10,0,0,5"
                             IsVisible="{Binding $parent[Window].DataContext.SidebarExpanded}"/>
                  <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Classes="navRow" Height="30" Margin="0,1"
                                HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"
                                Command="{Binding $parent[Window].DataContext.NavigateCommand}"
                                CommandParameter="{Binding Page}"
                                Classes.sel="{Binding IsActive}"
                                Classes.hueOchre="{Binding IsHueOchre}" Classes.hueForest="{Binding IsHueForest}"
                                Classes.hueTeal="{Binding IsHueTeal}" Classes.hueClay="{Binding IsHueClay}"
                                Classes.hueUmber="{Binding IsHueUmber}" Classes.hueBerry="{Binding IsHueBerry}"
                                Classes.hueViolet="{Binding IsHueViolet}" Classes.hueStone="{Binding IsHueStone}"
                                ToolTip.Tip="{Binding Label}"
                                AutomationProperties.AutomationId="NavItem">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <local:LucideGlyph Glyph="{Binding Icon}" GlyphSize="16"
                                               GlyphBrush="{DynamicResource Brush.Ink}"
                                               StrokeThickness="1.5"/>
                            <TextBlock Grid.Column="1" Text="{Binding Label}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       IsVisible="{Binding $parent[Window].DataContext.SidebarExpanded}"/>
                            <!-- Today-only overdue count badge (premium-polish 3.3) -->
                            <Border Grid.Column="2" MinWidth="17" Height="17" CornerRadius="8.5"
                                    Background="{DynamicResource Brush.SelBg}"
                                    Padding="4,0" VerticalAlignment="Center"
                                    IsVisible="{Binding Badge, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    AutomationProperties.AutomationId="NavBadge">
                              <TextBlock Text="{Binding Badge}" FontSize="9.5" FontWeight="SemiBold"
                                         Foreground="{DynamicResource Brush.Ink}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- Settings pinned at the bottom -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0"
                Margin="8,4,8,10" Padding="0,6,0,0">
          <Button Classes="navRow" Height="30" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"
                  Command="{Binding NavigateCommand}" CommandParameter="{Binding SettingsItem.Page}"
                  Classes.sel="{Binding IsSettingsActive}" Classes.hueStone="True"
                  ToolTip.Tip="Settings"
                  AutomationProperties.AutomationId="NavSettings">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <local:LucideGlyph Glyph="settings" GlyphSize="16"
                                 GlyphBrush="{DynamicResource Brush.Ink}"
                                 StrokeThickness="1.5"/>
              <TextBlock Grid.Column="1" Text="Settings" VerticalAlignment="Center"
                         IsVisible="{Binding SidebarExpanded}"/>
            </Grid>
          </Button>
        </Border>
      </Grid>
    </Border>

    <!-- ============ Right column — toolbar + the single page host ============ -->
    <Grid Grid.Column="1" Grid.RowDefinitions="52,*">
      <!-- Toolbar: opaque paper with a 1px divider; no acrylic, no coloured bars (3.1).
           Left: sidebar toggle, screen filter (⌘F), Commands (⌘K). Right: the user chip.
           The page title lives in the page content, not here (3.2). -->
      <Border x:Name="ToolbarRow" Background="{DynamicResource Brush.Paper}"
              BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1"
              AutomationProperties.AutomationId="Toolbar">
        <Grid x:Name="ToolbarContent" ColumnDefinitions="Auto,10,Auto,10,Auto,*,Auto,12" VerticalAlignment="Center" Margin="14,0,14,0"
              IsVisible="{Binding SignedIn}">
          <Button x:Name="SidebarToggle" Classes="ghost" Height="28" Width="30" Padding="4,0"
                  Command="{Binding ToggleSidebarCommand}"
                  AutomationProperties.Name="Toggle sidebar"
                  ToolTip.Tip="Toggle sidebar (⌥⌘S)">
            <Grid Width="17" Height="17">
              <local:LucideGlyph Glyph="panel-left-close" GlyphBrush="{DynamicResource Brush.Ink}" StrokeThickness="1.5" IsVisible="{Binding SidebarExpanded}" />
              <local:LucideGlyph Glyph="panel-left-open"  GlyphBrush="{DynamicResource Brush.Ink}" StrokeThickness="1.5" IsVisible="{Binding SidebarCollapsed}" />
            </Grid>
          </Button>
          <TextBox x:Name="ToolbarSearch" Grid.Column="2" Classes="searchfield" Width="220" Height="28" FontSize="12.5"
                   PlaceholderText="Filter"
                   ToolTip.Tip="Filter the current screen (⌘F)"
                   AutomationProperties.AutomationId="ToolbarSearch"/>
          <Button x:Name="PaletteButton" Grid.Column="4" Classes="ghost" Height="26" Padding="6,0"
                  Command="{Binding TogglePaletteCommand}"
                  AutomationProperties.AutomationId="PaletteButton"
                  ToolTip.Tip="Command palette (⌘K)">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="Commands" FontSize="11.5" VerticalAlignment="Center"/>
              <Border Classes="keycap" VerticalAlignment="Center"><TextBlock Text="⌘K" /></Border>
            </StackPanel>
          </Button>
          <!-- empty stretch: dragging here moves the window (handled in code-behind) -->
          <Border x:Name="ToolbarDragStrip" Grid.Column="5" Background="Transparent" />
          <Button x:Name="UserChip" Grid.Column="6" Classes="ghost" Height="28" Padding="2,0"
                  AutomationProperties.Name="Account and appearance">
            <Border Width="24" Height="24" CornerRadius="12"
                    Background="{DynamicResource Brush.SelBg}"
                    HorizontalAlignment="Right">
              <TextBlock x:Name="UserChipInitials" Text="{Binding Initials}"
                         FontSize="9" FontWeight="SemiBold"
                         Foreground="{DynamicResource Brush.Ink}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </Button>
        </Grid>
      </Border>

      <!-- content area (one host — the page control instance is single-owned;
           the text-scale wrapper is attached in code-behind on page change) -->
      <ContentControl x:Name="PageHost" Grid.Row="1" Background="{DynamicResource Brush.Paper}"
                      AutomationProperties.AutomationId="PageHost" />
    </Grid>

    <!-- ============ command palette overlay (on top) ============ -->
    <Grid Grid.ColumnSpan="2" Grid.RowSpan="2"
          x:Name="PaletteOverlay"
          IsVisible="{Binding PaletteOpen}"
          AutomationProperties.AutomationId="CommandPalette">
      <Border Background="{DynamicResource Brush.Scrim}" />
      <Border x:Name="PaletteBackdrop" Background="Transparent" />
      <Border Width="600" MaxHeight="420" HorizontalAlignment="Center" VerticalAlignment="Top"
              Margin="0,60,0,0" CornerRadius="10"
              Background="{DynamicResource Brush.Surface}"
              BorderBrush="{DynamicResource Brush.ControlBorder}"
              BorderThickness="1" Padding="10"
              BoxShadow="{StaticResource Shadow.Overlay}">
        <StackPanel Spacing="6">
          <TextBox x:Name="PaletteSearch" Height="36" FontSize="14"
                   Watermark="Search requirements, evidence, issues, sources. Return opens."
                   Text="{Binding SearchText, Mode=TwoWay}"
                   AutomationProperties.AutomationId="PaletteSearch"/>
          <ListBox x:Name="PaletteResults"
                   ItemsSource="{Binding SearchResults}"
                   SelectedItem="{Binding SelectedSearchResult, Mode=TwoWay}"
                   MinHeight="40" MaxHeight="300" Background="Transparent" BorderThickness="0"
                   ItemTemplate="{StaticResource PaletteResultTemplate}" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>