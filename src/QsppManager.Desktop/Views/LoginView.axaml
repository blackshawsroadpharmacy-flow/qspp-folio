<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QsppManager.Desktop"
             x:Class="QsppManager.Desktop.Views.LoginView">
  <Grid>
    <Border Classes="card" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28,26" BoxShadow="0 2 14 0 #16000000">
      <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <local:LucideGlyph Glyph="shield-check" GlyphSize="22" GlyphBrush="{DynamicResource Brush.Green}" />
          <TextBlock Classes="h2" FontSize="20">QSPP Manager</TextBlock>
        </StackPanel>
        <TextBlock Classes="small" TextWrapping="Wrap" Margin="0,0,0,8">Local practice accreditation workspace. Accounts and records stay on this computer; roles decide who can verify evidence and change readiness.</TextBlock>
        <TextBox x:Name="UserName" Watermark="User name" />
        <TextBox x:Name="Passphrase" Watermark="Passphrase" PasswordChar="•" />
        <TextBlock x:Name="Message" Classes="small" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Caution}" />
        <Button x:Name="LoginBtn" Classes="primary" Content="Sign in" Height="38" HorizontalAlignment="Stretch" Margin="0,6,0,0" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>