<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="QsppManager.Desktop.Views.LoginView">
  <Grid>
    <Border Classes="card" MaxWidth="430" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32,30" BoxShadow="0 2 14 0 #16000000">
      <StackPanel Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="0,0,0,2">
          <!-- Avatar mark: rounded crop of the client logo, thin brand-green keyline. -->
          <Border Width="44" Height="44" CornerRadius="22" ClipToBounds="True" BorderBrush="{DynamicResource Brush.Green}" BorderThickness="2">
            <Image Source="avares://QsppManager.Desktop/Assets/Art/HughLogo.png" Stretch="UniformToFill" />
          </Border>
          <StackPanel VerticalAlignment="Center" Spacing="1">
            <TextBlock Classes="h2" FontSize="20">Hugh's QSPP Manager</TextBlock>
            <TextBlock Classes="small" Text="Burke Road Compounding Pharmacy" />
          </StackPanel>
        </StackPanel>
        <TextBlock Classes="small" TextWrapping="Wrap" Margin="0,2,0,6">Local practice accreditation workspace. Accounts and records stay on this computer; roles decide who can verify evidence and change readiness.</TextBlock>
        <StackPanel Spacing="6">
          <TextBlock Classes="label">USER NAME</TextBlock>
          <TextBox x:Name="UserName" Watermark="User name" Height="34" />
        </StackPanel>
        <StackPanel Spacing="6">
          <TextBlock Classes="label">PASSPHRASE</TextBlock>
          <TextBox x:Name="Passphrase" Watermark="Passphrase" PasswordChar="•" Height="34" />
        </StackPanel>
        <TextBlock x:Name="Message" Classes="small" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Caution}" />
        <Button x:Name="LoginBtn" Classes="primary" Content="Sign in" Height="38" HorizontalAlignment="Stretch" Margin="0,8,0,0" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>