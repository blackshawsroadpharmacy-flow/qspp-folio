<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="QsppManager.Desktop.Views.RequirementsView">
  <Grid ColumnDefinitions="380,*">
    <Border Grid.Column="0" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,0,1,0" Background="{StaticResource Brush.White}">
      <DockPanel Margin="12,12">
        <TextBox x:Name="FilterBox" DockPanel.Dock="Top" Watermark="Filter by reference or title" />
        <TextBlock x:Name="CountLabel" DockPanel.Dock="Top" Classes="small" Margin="0,6,0,0" />
        <ListBox x:Name="ReqList" Margin="0,8,0,0" BorderThickness="0" Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="2,4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Ref}" FontFamily="JetBrains Mono" FontSize="12" />
                  <TextBlock Text="{Binding ReadinessLabel}" Classes="small" />
                </StackPanel>
                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="small" Text="{Binding OwnerNote}" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
    <ContentControl x:Name="Detail" Grid.Column="1" />
  </Grid>
</UserControl>