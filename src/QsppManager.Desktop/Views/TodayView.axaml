<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="QsppManager.Desktop.Views.TodayView">
  <ScrollViewer>
    <StackPanel Margin="32,28" Spacing="18" MaxWidth="1100" HorizontalAlignment="Left">

      <StackPanel>
        <TextBlock Classes="h1" Text="{Binding Greeting}" />
        <TextBlock Classes="lead" Text="{Binding SubGreeting}" TextWrapping="Wrap" />
      </StackPanel>

      <!-- Figures: few, real, each opens its records -->
      <StackPanel Orientation="Horizontal" Spacing="32">
        <StackPanel>
          <TextBlock Classes="label">OVERDUE TASKS</TextBlock>
          <TextBlock Classes="h2" FontWeight="SemiBold" Text="{Binding OverdueCount}" />
          <Button Classes="tertiary" Content="Open tasks" Padding="0" Height="26" Command="{Binding OpenTasksCommand}" />
        </StackPanel>
        <StackPanel>
          <TextBlock Classes="label">EVIDENCE AWAITING REVIEW</TextBlock>
          <TextBlock Classes="h2" FontWeight="SemiBold" Text="{Binding AwaitingReviewCount}" />
          <Button Classes="tertiary" Content="Open documents" Padding="0" Height="26" Command="{Binding OpenDocumentsCommand}" />
        </StackPanel>
        <StackPanel>
          <TextBlock Classes="label">MANAGER-VERIFIED REQUIREMENTS</TextBlock>
          <TextBlock Classes="h2" FontWeight="SemiBold" Text="{Binding VerifiedShare}" />
          <Button Classes="tertiary" Content="Open requirements" Padding="0" Height="26" Command="{Binding OpenRequirementsCommand}" />
        </StackPanel>
        <StackPanel>
          <TextBlock Classes="label">UNRESOLVED INTERPRETATIONS</TextBlock>
          <TextBlock Classes="h2" FontWeight="SemiBold" Text="{Binding IssuesCount}" />
          <TextBlock Classes="small" Text="Sources disagree — planning dates only" TextWrapping="Wrap" MaxWidth="220" />
        </StackPanel>
      </StackPanel>

      <!-- Overdue -->
      <StackPanel>
        <TextBlock Classes="h3">Overdue tasks</TextBlock>
        <ItemsControl ItemsSource="{Binding Overdue}" Margin="0,6,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Padding="0,8" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="8,*,Auto">
                  <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center" Fill="{StaticResource Brush.Alert}" />
                  <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="{Binding Title}" />
                    <TextBlock Classes="small" Text="{Binding MetaLine}" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Classes="small" VerticalAlignment="Center" Text="{Binding DueLabel}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="NoOverdue" Classes="small" Text="Nothing overdue." />
      </StackPanel>

      <!-- Due this week -->
      <StackPanel>
        <TextBlock Classes="h3">Due in the next 7 days</TextBlock>
        <ItemsControl ItemsSource="{Binding DueThisWeek}" Margin="0,6,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Padding="0,8" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="8,*,Auto">
                  <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center" Fill="{StaticResource Brush.Caution}" />
                  <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="{Binding Title}" />
                    <TextBlock Classes="small" Text="{Binding MetaLine}" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Classes="small" VerticalAlignment="Center" Text="{Binding DueLabel}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="NoDueWeek" Classes="small" Text="Nothing due in the next 7 days." />
      </StackPanel>

      <!-- Deadlines -->
      <StackPanel>
        <TextBlock Classes="h3">Program deadlines and plan markers</TextBlock>
        <TextBlock Classes="small" TextWrapping="Wrap" MaxWidth="640" HorizontalAlignment="Left">Dates marked "planning only" are the conservative reading of sources that disagree. They are planning aids, not program deadlines. The Settings page lists each conflicting source in full.</TextBlock>
        <ItemsControl ItemsSource="{Binding Deadlines}" Margin="0,6,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Padding="0,8" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,0,0,1">
                <StackPanel>
                  <TextBlock Text="{Binding DateLabel}" Classes="mono" />
                  <TextBlock Text="{Binding Title}" />
                  <TextBlock Classes="small" Text="{Binding Explanation}" TextWrapping="Wrap" MaxWidth="780" HorizontalAlignment="Left" />
                  <Border Classes="tag" HorizontalAlignment="Left" Margin="0,4,0,0" IsVisible="{Binding PlanningOnly}">
                    <TextBlock Text="PLANNING ONLY — SOURCES DISAGREE" />
                  </Border>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Evidence awaiting review -->
      <StackPanel>
        <TextBlock Classes="h3">Evidence awaiting review</TextBlock>
        <ItemsControl ItemsSource="{Binding Awaiting}" Margin="0,6,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Padding="0,8" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,0,0,1">
                <TextBlock Text="{Binding TitleLine}" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="NoAwaiting" Classes="small" Text="No evidence is waiting for a reviewer." />
      </StackPanel>

      <!-- Recent work -->
      <StackPanel>
        <TextBlock Classes="h3">Recent activity</TextBlock>
        <ItemsControl ItemsSource="{Binding Recent}" Margin="0,6,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Padding="0,6" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,0,0,1">
                <TextBlock Classes="small" Text="{Binding Line}" TextWrapping="Wrap" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>