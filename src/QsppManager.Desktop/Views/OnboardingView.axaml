<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="QsppManager.Desktop.Views.OnboardingView">
  <ScrollViewer>
    <StackPanel Margin="40,36" Spacing="12" MaxWidth="640" HorizontalAlignment="Left">
      <TextBlock Classes="h1">Welcome to QSPP Manager</TextBlock>
      <TextBlock Classes="lead" TextWrapping="Wrap">Set up your pharmacy profile and the first Owner / Admin account. Everything stays on this computer: the reference corpus sits beside the program, and your records live in the application data folder.</TextBlock>
      <Border Classes="card" Margin="0,14,0,0" Padding="20">
        <StackPanel Spacing="12">
          <StackPanel Spacing="6">
            <TextBlock Classes="label">PHARMACY</TextBlock>
            <TextBox x:Name="PharmacyName" Watermark="Your pharmacy's trading name" />
          </StackPanel>
          <StackPanel Spacing="6">
            <TextBlock Classes="label">JURISDICTION · TIME ZONE</TextBlock>
            <ComboBox x:Name="Jur" SelectedIndex="0" HorizontalAlignment="Left">
              <ComboBoxItem>VIC · Australia/Melbourne</ComboBoxItem>
              <ComboBoxItem>NSW · Australia/Sydney</ComboBoxItem>
              <ComboBoxItem>QLD · Australia/Brisbane</ComboBoxItem>
              <ComboBoxItem>WA · Australia/Perth</ComboBoxItem>
              <ComboBoxItem>SA · Australia/Adelaide</ComboBoxItem>
            </ComboBox>
          </StackPanel>
          <TextBlock Classes="small" Text="Accreditation dates can stay unknown, decide later; the program will create a follow-up task instead of guessing." TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Border Classes="card" Margin="0,6,0,0" Padding="20">
        <StackPanel Spacing="12">
          <TextBlock Classes="label">FIRST OWNER / ADMIN ACCOUNT</TextBlock>
          <StackPanel Spacing="6">
            <TextBlock Classes="label">FULL NAME</TextBlock>
            <TextBox x:Name="DisplayName" Watermark="Given name and surname" />
          </StackPanel>
          <StackPanel Spacing="6">
            <TextBlock Classes="label">USER NAME</TextBlock>
            <TextBox x:Name="UserName" Watermark="Used to sign in" Text="owner" />
          </StackPanel>
          <StackPanel Spacing="6">
            <TextBlock Classes="label">PASSPHRASE</TextBlock>
            <TextBox x:Name="Passphrase" Watermark="Minimum 8 characters" PasswordChar="•" />
          </StackPanel>
          <TextBlock x:Name="Message" Classes="small" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Caution}" />
          <Button x:Name="CreateBtn" Classes="primary" HorizontalAlignment="Left" Content="Create account and continue" Height="40" Margin="0,4,0,0" />
        </StackPanel>
      </Border>
      <TextBlock Classes="small" TextWrapping="Wrap" Margin="0,12,0,0">QSPP Manager does not award accreditation and is not an official program system. Program requirements live in the packed source documents; the Library lists every imported version.</TextBlock>
    </StackPanel>
  </ScrollViewer>
</UserControl>