<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QsppManager.Desktop"
             x:Class="QsppManager.Desktop.Views.LoadingView">
  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
    <local:LucideGlyph Glyph="database" GlyphSize="28" GlyphBrush="{DynamicResource Brush.Green}" HorizontalAlignment="Center" />
    <TextBlock Classes="h2" Text="Loading…" />
    <TextBlock Classes="small" Text="Importing the reference corpus and opening the local database." />
  </StackPanel>
</UserControl>