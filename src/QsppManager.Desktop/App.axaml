<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="QsppManager.Desktop.App"
             xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid">

  <Application.Resources>

    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>

        <!-- ============ LIGHT — warm paper + forest green (OpenScript palette) ============ -->
        <ResourceDictionary x:Key="Light">
          <Color x:Key="Color.Paper">#F5F5EB</Color>
          <Color x:Key="Color.White">#FFFEF8</Color>
          <Color x:Key="Color.Sage">#E4EADC</Color>
          <Color x:Key="Color.Ink">#163F35</Color>
          <Color x:Key="Color.Green">#23614D</Color>
          <Color x:Key="Color.GreenHover">#2E7A61</Color>
          <Color x:Key="Color.Muted">#52685C</Color>
          <Color x:Key="Color.Divider">#DCE2D4</Color>
          <Color x:Key="Color.ControlBorder">#CBD4C2</Color>
          <Color x:Key="Color.Acid">#DBE76B</Color>
          <Color x:Key="Color.Focus">#AB5537</Color>
          <Color x:Key="Color.Alert">#9A3F1F</Color>
          <Color x:Key="Color.Caution">#7A5200</Color>
          <Color x:Key="Color.CautionBg">#FBF6E9</Color>
          <Color x:Key="Color.Error">#A32A2A</Color>
          <Color x:Key="Color.RowHover">#EDF0DF</Color>
          <Color x:Key="Color.SelBg">#DCE4CF</Color>
          <Color x:Key="Color.Sidebar">#E9EDDF</Color>
          <Color x:Key="Color.HoverTint">#66163F35</Color>
          <Color x:Key="Color.DangerBg">#F3E4DB</Color>
          <Color x:Key="Color.OkBg">#E9F0DC</Color>
          <SolidColorBrush x:Key="Brush.Paper" Color="{StaticResource Color.Paper}" />
          <SolidColorBrush x:Key="Brush.White" Color="{StaticResource Color.White}" />
          <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.White}" />
          <SolidColorBrush x:Key="Brush.Sage" Color="{StaticResource Color.Sage}" />
          <SolidColorBrush x:Key="Brush.Ink" Color="{StaticResource Color.Ink}" />
          <SolidColorBrush x:Key="Brush.Green" Color="{StaticResource Color.Green}" />
          <SolidColorBrush x:Key="Brush.GreenHover" Color="{StaticResource Color.GreenHover}" />
          <SolidColorBrush x:Key="Brush.Muted" Color="{StaticResource Color.Muted}" />
          <SolidColorBrush x:Key="Brush.Divider" Color="{StaticResource Color.Divider}" />
          <SolidColorBrush x:Key="Brush.ControlBorder" Color="{StaticResource Color.ControlBorder}" />
          <SolidColorBrush x:Key="Brush.Acid" Color="{StaticResource Color.Acid}" />
          <SolidColorBrush x:Key="Brush.Focus" Color="{StaticResource Color.Focus}" />
          <SolidColorBrush x:Key="Brush.Alert" Color="{StaticResource Color.Alert}" />
          <SolidColorBrush x:Key="Brush.Caution" Color="{StaticResource Color.Caution}" />
          <SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Color.Error}" />
          <SolidColorBrush x:Key="Brush.RowHover" Color="{StaticResource Color.RowHover}" />
          <SolidColorBrush x:Key="Brush.SelBg" Color="{StaticResource Color.SelBg}" />
          <SolidColorBrush x:Key="Brush.Sidebar" Color="{StaticResource Color.Sidebar}" />
          <SolidColorBrush x:Key="Brush.HoverTint" Color="{StaticResource Color.HoverTint}" />
          <SolidColorBrush x:Key="Brush.DangerBg" Color="{StaticResource Color.DangerBg}" />
          <SolidColorBrush x:Key="Brush.OkBg" Color="{StaticResource Color.OkBg}" />
        </ResourceDictionary>

        <!-- ============ DARK — derived from the same green identity ============ -->
        <ResourceDictionary x:Key="Dark">
          <Color x:Key="Color.Paper">#121815</Color>
          <Color x:Key="Color.White">#1A221C</Color>
          <Color x:Key="Color.Sage">#24312A</Color>
          <Color x:Key="Color.Ink">#E8EFE7</Color>
          <Color x:Key="Color.Green">#3F9A76</Color>
          <Color x:Key="Color.GreenHover">#4CAC86</Color>
          <Color x:Key="Color.Muted">#9DB0A6</Color>
          <Color x:Key="Color.Divider">#27312B</Color>
          <Color x:Key="Color.ControlBorder">#35423B</Color>
          <Color x:Key="Color.Acid">#DBE76B</Color>
          <Color x:Key="Color.Focus">#F0A57D</Color>
          <Color x:Key="Color.Alert">#C75B32</Color>
          <Color x:Key="Color.Caution">#C79B49</Color>
          <Color x:Key="Color.CautionBg">#2E2410</Color>
          <Color x:Key="Color.Error">#DA6E6E</Color>
          <Color x:Key="Color.RowHover">#1F2924</Color>
          <Color x:Key="Color.SelBg">#2E4137</Color>
          <Color x:Key="Color.Sidebar">#141A16</Color>
          <Color x:Key="Color.HoverTint">#40E8EFE7</Color>
          <Color x:Key="Color.DangerBg">#3B2A22</Color>
          <Color x:Key="Color.OkBg">#25342A</Color>
          <SolidColorBrush x:Key="Brush.Paper" Color="{StaticResource Color.Paper}" />
          <SolidColorBrush x:Key="Brush.White" Color="{StaticResource Color.White}" />
          <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.White}" />
          <SolidColorBrush x:Key="Brush.Sage" Color="{StaticResource Color.Sage}" />
          <SolidColorBrush x:Key="Brush.Ink" Color="{StaticResource Color.Ink}" />
          <SolidColorBrush x:Key="Brush.Green" Color="{StaticResource Color.Green}" />
          <SolidColorBrush x:Key="Brush.GreenHover" Color="{StaticResource Color.GreenHover}" />
          <SolidColorBrush x:Key="Brush.Muted" Color="{StaticResource Color.Muted}" />
          <SolidColorBrush x:Key="Brush.Divider" Color="{StaticResource Color.Divider}" />
          <SolidColorBrush x:Key="Brush.ControlBorder" Color="{StaticResource Color.ControlBorder}" />
          <SolidColorBrush x:Key="Brush.Acid" Color="{StaticResource Color.Acid}" />
          <SolidColorBrush x:Key="Brush.Focus" Color="{StaticResource Color.Focus}" />
          <SolidColorBrush x:Key="Brush.Alert" Color="{StaticResource Color.Alert}" />
          <SolidColorBrush x:Key="Brush.Caution" Color="{StaticResource Color.Caution}" />
          <SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Color.Error}" />
          <SolidColorBrush x:Key="Brush.RowHover" Color="{StaticResource Color.RowHover}" />
          <SolidColorBrush x:Key="Brush.SelBg" Color="{StaticResource Color.SelBg}" />
          <SolidColorBrush x:Key="Brush.Sidebar" Color="{StaticResource Color.Sidebar}" />
          <SolidColorBrush x:Key="Brush.HoverTint" Color="{StaticResource Color.HoverTint}" />
          <SolidColorBrush x:Key="Brush.DangerBg" Color="{StaticResource Color.DangerBg}" />
          <SolidColorBrush x:Key="Brush.OkBg" Color="{StaticResource Color.OkBg}" />
        </ResourceDictionary>

      </ResourceDictionary.ThemeDictionaries>

      <!-- System UI type on macOS with the brand fallbacks; mono reserved for codes/ids -->
      <FontFamily x:Key="Font.Ui">SF Pro Text, SF Pro, Host Grotesk, Helvetica Neue, Helvetica, Arial</FontFamily>
      <FontFamily x:Key="Font.Mono">avares://QsppManager.Desktop/Assets/Fonts/JetBrainsMono-Regular.ttf#JetBrains Mono, SF Mono, Menlo, Consolas, monospace</FontFamily>
      <FontFamily x:Key="Font.MonoMedium">avares://QsppManager.Desktop/Assets/Fonts/JetBrainsMono-Medium.ttf#JetBrains Mono Medium, SF Mono, Menlo, monospace</FontFamily>
      <FontFamily x:Key="Font.Brand">avares://QsppManager.Desktop/Assets/Fonts/HostGrotesk.ttf#Host Grotesk, SF Pro Text, Helvetica Neue</FontFamily>

      <!-- Fluent theme tab-header font: shrink from the 24px default (M7.2) -->
      <x:Double x:Key="TabItemHeaderFontSize">13.5</x:Double>
      <x:Double x:Key="TabItemMinHeight">34</x:Double>
    </ResourceDictionary>

  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- Base typography: inherits everywhere -->
    <Style Selector="Window, UserControl">
      <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
      <Setter Property="Background" Value="{DynamicResource Brush.Paper}" />
    </Style>

    <!-- Type scale -->
    <Style Selector="TextBlock.h1"><Setter Property="FontSize" Value="26" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="LetterSpacing" Value="-0.4" /></Style>
    <Style Selector="TextBlock.h2"><Setter Property="FontSize" Value="19" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="LetterSpacing" Value="-0.25" /></Style>
    <Style Selector="TextBlock.h3"><Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="LetterSpacing" Value="-0.1" /></Style>
    <Style Selector="TextBlock.lead"><Setter Property="FontSize" Value="14" /><Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" /></Style>
    <Style Selector="TextBlock.small"><Setter Property="FontSize" Value="11.5" /><Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" /></Style>
    <Style Selector="TextBlock.label"><Setter Property="FontSize" Value="10.5" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="LetterSpacing" Value="0.5" /><Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" /></Style>
    <Style Selector="TextBlock.mono"><Setter Property="FontFamily" Value="{StaticResource Font.Mono}" /><Setter Property="FontSize" Value="12" /></Style>
    <Style Selector="TextBlock.monoSm"><Setter Property="FontFamily" Value="{StaticResource Font.Mono}" /><Setter Property="FontSize" Value="11" /></Style>

    <!-- Tab headers: Fluent's TabItemHeaderFontSize default of 24 blew out the detail-page
         tabs (four oversized headers wrapped, leaving a giant orphan line). M7.2 keeps them
         compact, one line, and quiet until selected. -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- Buttons: rounded, compact Mac push buttons -->
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.ControlBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource Brush.Green}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Green}" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.GreenHover}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.Green}" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.Sage}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.Sage}" />
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
    </Style>
    <Style Selector="Button.destructive">
      <Setter Property="Background" Value="{DynamicResource Brush.Alert}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Alert}" />
    </Style>
    <!-- Colour language, so action buttons read at a glance:
         primary  = filled green   — the one action that CREATES something here
         verify   = green outline  — a POSITIVE compliance claim (verify/accept), lighter than primary
         caution  = amber outline  — a CORRECTIVE action (send back, needs rework)
         destructive = filled alert red — withdrawal/removal
         everything else stays the quiet outlined default -->
    <Style Selector="Button.verify">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Green}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Green}" />
    </Style>
    <Style Selector="Button.verify:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.OkBg}" />
    </Style>
    <Style Selector="Button.verify:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.OkBg}" />
    </Style>
    <Style Selector="Button.caution">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Caution}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Caution}" />
    </Style>
    <Style Selector="Button.caution:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.CautionBg}" />
    </Style>
    <Style Selector="Button.caution:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.CautionBg}" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Green}" />
    </Style>

    <!-- Inputs -->
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.ControlBorder}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_Border">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Green}" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.ControlBorder}" />
      <Setter Property="Padding" Value="10,0" />
    </Style>

    <!-- Sidebar navigation: clean pill selection, no borders -->
    <Style Selector="ListBox.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem">
      <Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Margin" Value="10,2" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.HoverTint}" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.SelBg}" />
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected">
      <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- DataGrid: quiet rows, hairlines, sage selection -->
    <Style Selector="dg|DataGrid">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="RowBackground" Value="Transparent" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Brush.Divider}" />
      <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
      <Setter Property="RowHeight" Value="36" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="CanUserReorderColumns" Value="False" />
    </Style>
    <Style Selector="dg|DataGridColumnHeader">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Divider}" />
    </Style>
    <Style Selector="dg|DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="{DynamicResource Brush.RowHover}" />
    </Style>
    <Style Selector="dg|DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="{DynamicResource Brush.SelBg}" />
    </Style>
    <Style Selector="dg|DataGridRow:selected">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    </Style>

    <!-- Status chips -->
    <Style Selector="Border.tag">
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="{DynamicResource Brush.Sage}" />
    </Style>

    <!-- Cards in XAML views -->
    <Style Selector="Border.card">
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Divider}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="BoxShadow" Value="0 1 0 0 #14000000" />
    </Style>

    <!-- Content lists (two-line rows): hover tint + sage selection -->
    <Style Selector="ListBox.list">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="SelectionMode" Value="Single,AlwaysSelected" />
    </Style>
    <Style Selector="ListBox.list ListBoxItem">
      <Setter Property="MinHeight" Value="52" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="11,9" />
      <Setter Property="Margin" Value="2,2" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBox.list ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.HoverTint}" />
    </Style>
    <Style Selector="ListBox.list ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.SelBg}" />
    </Style>
    <Style Selector="ListBox.list ListBoxItem:selected">
      <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <!-- Interpretation-issue box: caution tint, themed -->
    <Style Selector="Border.issuebox">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource Brush.CautionBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Caution}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12" />
    </Style>

    <!-- Result strip on work pages -->
    <Style Selector="TextBox.result">
      <Setter Property="Background" Value="{DynamicResource Brush.Sage}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
      <Setter Property="FontSize" Value="11.5" />
    </Style>

    <!-- Keyboard focus visibility: brand terracotta ring where the template exposes it -->
    <Style Selector=":is(Control):focus /template/ Border#PART_FocusVisual">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
    </Style>
  </Application.Styles>
</Application>