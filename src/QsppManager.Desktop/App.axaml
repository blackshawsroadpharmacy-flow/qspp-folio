<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:QsppManager.Desktop"
             x:Class="QsppManager.Desktop.App"
             xmlns:dg="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid">

  <Application.Resources>

    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>

        <!-- ============ LIGHT — warm paper + forest green (OpenScript palette) ============ -->
        <ResourceDictionary x:Key="Light">
          <Color x:Key="Color.Paper">#F5F5EB</Color>
          <Color x:Key="Color.White">#FFFEF8</Color>
          <Color x:Key="Color.Sage">#E4EADC</Color>
          <Color x:Key="Color.Ink">#163F35</Color>
          <Color x:Key="Color.Green">#23614D</Color>
          <Color x:Key="Color.GreenSoft">#23614D</Color>
          <Color x:Key="Color.GreenHover">#2E7A61</Color>
          <Color x:Key="Color.Muted">#52685C</Color>
          <Color x:Key="Color.Divider">#DCE2D4</Color>
          <Color x:Key="Color.ControlBorder">#CBD4C2</Color>
          <SolidColorBrush x:Key="TabItemHeaderSelectedPipeFill" Color="{StaticResource Color.Green}" />
          <SolidColorBrush x:Key="CalendarDatePickerGlyphBrush" Color="{StaticResource Color.Muted}" />
          <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="{StaticResource Color.Green}" />
          <SolidColorBrush x:Key="TextControlBorderBrushPressed" Color="{StaticResource Color.Green}" />
          <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="{StaticResource Color.ControlBorder}" />
          <Color x:Key="Color.Acid">#DBE76B</Color>
          <Color x:Key="Color.Focus">#AB5537</Color>
          <Color x:Key="Color.Alert">#9A3F1F</Color>
          <Color x:Key="Color.Caution">#7A5200</Color>
          <Color x:Key="Color.CautionBg">#FBF6E9</Color>
          <Color x:Key="Color.Error">#A32A2A</Color>
          <Color x:Key="Color.RowHover">#EDF0DF</Color>
          <Color x:Key="Color.SelBg">#DCE4CF</Color>
          <Color x:Key="Color.Sidebar">#E9EDDF</Color>
          <Color x:Key="Color.HoverTint">#0F163F35</Color>
          <Color x:Key="Color.DangerBg">#F3E4DB</Color>
          <Color x:Key="Color.OkBg">#E9F0DC</Color>
          <!-- Palette scrim + glow (command palette dim + shadow): 27% black on paper -->
          <Color x:Key="Color.Scrim">#44000000</Color>
          <Color x:Key="Color.Glow">#33000000</Color>
          <BoxShadows x:Key="Shadow.Overlay">0 10 24 0 #33000000</BoxShadows>
          <!-- Today hero ground: designed values per theme. Light: ink ground, surface text.
               Dark: a designed deep green below, never a naive inversion. -->
          <Color x:Key="Color.HeroMuted">#C7D8CC</Color>
          <Color x:Key="Color.HeroDiv">#3D5C51</Color>
          <!-- Accent overrides: the toolkit default accent is BLUE; this app's identity is green. -->
          <Color x:Key="SystemAccentColor">#23614D</Color>
          <Color x:Key="SystemAccentColorDark1">#1E5542</Color>
          <Color x:Key="SystemAccentColorDark2">#194737</Color>
          <Color x:Key="SystemAccentColorLight1">#31725B</Color>
          <Color x:Key="SystemAccentColorLight2">#3F8469</Color>
          <SolidColorBrush x:Key="Brush.Paper" Color="{StaticResource Color.Paper}" />
          <SolidColorBrush x:Key="Brush.White" Color="{StaticResource Color.White}" />
          <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.White}" />
          <SolidColorBrush x:Key="Brush.Sage" Color="{StaticResource Color.Sage}" />
          <SolidColorBrush x:Key="Brush.Ink" Color="{StaticResource Color.Ink}" />
          <SolidColorBrush x:Key="Brush.Green" Color="{StaticResource Color.Green}" />
          <SolidColorBrush x:Key="Brush.GreenSoft" Color="{StaticResource Color.GreenSoft}" />
