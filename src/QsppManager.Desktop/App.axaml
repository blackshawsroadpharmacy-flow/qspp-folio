          <SolidColorBrush x:Key="Brush.HeroBg" Color="{StaticResource Color.Ink}" />
          <SolidColorBrush x:Key="Brush.HeroFg" Color="{StaticResource Color.White}" />
          <SolidColorBrush x:Key="Brush.HeroMuted" Color="{StaticResource Color.HeroMuted}" />
          <SolidColorBrush x:Key="Brush.HeroDiv" Color="{StaticResource Color.HeroDiv}" />
          <!-- Colour system v2 (3D, DD-44): hue meanings per the brief's tables.
               Forest = the existing Color.Green/Brush.Green; Red's light value = Color.Error. -->
          <Color x:Key="Color.Ink88">#E0163F35</Color>
          <Color x:Key="Color.Teal">#1F6A6A</Color>          <Color x:Key="Color.TealTint">#DBE4DC</Color>
          <Color x:Key="Color.Clay">#9A4228</Color>          <Color x:Key="Color.ClayTint">#EAE0D4</Color>
          <Color x:Key="Color.Berry">#A0345A</Color>         <Color x:Key="Color.BerryTint">#EBDEDA</Color>
          <Color x:Key="Color.Umber">#7A5A2E</Color>         <Color x:Key="Color.UmberTint">#E6E2D4</Color>
          <Color x:Key="Color.Ochre">#7E5400</Color>         <Color x:Key="Color.OchreTint">#E7E2CF</Color>
          <Color x:Key="Color.OchreFill">#D9A441</Color>
          <Color x:Key="Color.Violet">#6A4C9C</Color>        <Color x:Key="Color.VioletTint">#E4E1E2</Color>
          <Color x:Key="Color.Stone">#5E635A</Color>         <Color x:Key="Color.StoneTint">#E3E3DA</Color>
          <Color x:Key="Color.Red">#A32A2A</Color>           <Color x:Key="Color.RedTint">#EBD9D9</Color>
          <SolidColorBrush x:Key="Brush.Ink88" Color="{StaticResource Color.Ink88}" />
          <SolidColorBrush x:Key="Brush.Teal" Color="{StaticResource Color.Teal}" />       <SolidColorBrush x:Key="Brush.TealTint" Color="{StaticResource Color.TealTint}" />
          <SolidColorBrush x:Key="Brush.Clay" Color="{StaticResource Color.Clay}" />       <SolidColorBrush x:Key="Brush.ClayTint" Color="{StaticResource Color.ClayTint}" />
          <SolidColorBrush x:Key="Brush.Berry" Color="{StaticResource Color.Berry}" />     <SolidColorBrush x:Key="Brush.BerryTint" Color="{StaticResource Color.BerryTint}" />
          <SolidColorBrush x:Key="Brush.Umber" Color="{StaticResource Color.Umber}" />     <SolidColorBrush x:Key="Brush.UmberTint" Color="{StaticResource Color.UmberTint}" />
          <SolidColorBrush x:Key="Brush.Ochre" Color="{StaticResource Color.Ochre}" />     <SolidColorBrush x:Key="Brush.OchreTint" Color="{StaticResource Color.OchreTint}" />
          <SolidColorBrush x:Key="Brush.OchreFill" Color="{StaticResource Color.OchreFill}" />
          <SolidColorBrush x:Key="Brush.Violet" Color="{StaticResource Color.Violet}" />   <SolidColorBrush x:Key="Brush.VioletTint" Color="{StaticResource Color.VioletTint}" />
          <SolidColorBrush x:Key="Brush.Stone" Color="{StaticResource Color.Stone}" />     <SolidColorBrush x:Key="Brush.StoneTint" Color="{StaticResource Color.StoneTint}" />
          <SolidColorBrush x:Key="Brush.Red" Color="{StaticResource Color.Red}" />         <SolidColorBrush x:Key="Brush.RedTint" Color="{StaticResource Color.RedTint}" />
          <!-- Section band fills (Requirements list): the group hue at about 8% over the
               exact Surface ground; the band hover is 4% ink (owner band spec). -->
          <SolidColorBrush x:Key="Brush.BandInk" Color="{StaticResource Color.Ink}" Opacity="0.08" />
          <SolidColorBrush x:Key="Brush.BandTeal" Color="{StaticResource Color.Teal}" Opacity="0.08" />
          <SolidColorBrush x:Key="Brush.BandClay" Color="{StaticResource Color.Clay}" Opacity="0.08" />
          <SolidColorBrush x:Key="Brush.BandBerry" Color="{StaticResource Color.Berry}" Opacity="0.08" />
          <SolidColorBrush x:Key="Brush.BandUmber" Color="{StaticResource Color.Umber}" Opacity="0.08" />
          <SolidColorBrush x:Key="Brush.BandStone" Color="{StaticResource Color.Stone}" Opacity="0.08" />
          <SolidColorBrush x:Key="Brush.BandHover" Color="{StaticResource Color.Ink}" Opacity="0.04" />
        </ResourceDictionary>

