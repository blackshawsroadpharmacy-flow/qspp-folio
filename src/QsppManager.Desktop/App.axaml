      </ResourceDictionary.ThemeDictionaries>

      <!-- System UI type on macOS (3B v2): the Apple system face wins wherever Avalonia's
           macOS font manager accepts it; bundled Inter is last-resort. Report the winner
           with the fonts flag. -->
      <FontFamily x:Key="Font.Ui">$Default, .AppleSystemUIFont, SF Pro Text, SF Pro, Inter, Host Grotesk, Helvetica Neue, Helvetica, Arial</FontFamily>
      <!-- Display cut for 17pt-and-above sans roles (3B): SF Pro Display when installed,
           otherwise the system face. -->
      <FontFamily x:Key="Font.SansDisplay">$Default, .AppleSystemUIFont, SF Pro Display, SF Pro, Inter, Helvetica Neue, Helvetica</FontFamily>
      <FontFamily x:Key="Font.Mono">avares://QsppManager.Desktop/Assets/Fonts/JetBrainsMono-Regular.ttf#JetBrains Mono, SF Mono, Menlo, Consolas, monospace</FontFamily>
      <FontFamily x:Key="Font.MonoMedium">avares://QsppManager.Desktop/Assets/Fonts/JetBrainsMono-Medium.ttf#JetBrains Mono Medium, SF Mono, Menlo, monospace</FontFamily>
      <FontFamily x:Key="Font.Brand">avares://QsppManager.Desktop/Assets/Fonts/HostGrotesk.ttf#Host Grotesk, SF Pro Text, Helvetica Neue</FontFamily>
      <!-- Editorial serif (3B v2): bundled Newsreader (SIL OFL), Display cut for the big
           numerals and page titles. The files' internal family is "Newsreader 16pt 16pt"
           (the opsz-16 export); every stack leads with that exact name — "Newsreader"
           alone never matches and falls back to Georgia's text figures. Newsreader draws
           lining, tabular figures by default (verified via fontTools); Georgia has no
           lnum feature, so the trailing Georgia entry would leak text figures if it
           ever resolved — which is why the bundle name leads every stack. -->
      <FontFamily x:Key="Font.SerifDisplay">avares://QsppManager.Desktop/Assets/Fonts/Newsreader-Light.ttf#Newsreader 16pt 16pt Light, Newsreader Display, Newsreader, Georgia</FontFamily>
      <FontFamily x:Key="Font.SerifDisplayLight">avares://QsppManager.Desktop/Assets/Fonts/Newsreader-Light.ttf#Newsreader 16pt 16pt Light, Newsreader Display Light, Newsreader Light, Newsreader, Georgia</FontFamily>
      <FontFamily x:Key="Font.Serif">avares://QsppManager.Desktop/Assets/Fonts/Newsreader-Regular.ttf#Newsreader 16pt 16pt, Newsreader, Georgia, Hoefler Text, Times New Roman</FontFamily>
      <FontFamily x:Key="Font.SerifMedium">avares://QsppManager.Desktop/Assets/Fonts/Newsreader-Medium.ttf#Newsreader 16pt 16pt Medium, Newsreader Medium, Newsreader, Georgia</FontFamily>
      <FontFamily x:Key="Font.SerifItalic">avares://QsppManager.Desktop/Assets/Fonts/Newsreader-Italic.ttf#Newsreader 16pt 16pt, Newsreader Italic, Newsreader, Georgia Italic, Georgia</FontFamily>

      <!-- Fluent theme tab-header font: shrink from the 24px default (M7.2) -->
      <x:Double x:Key="TabItemHeaderFontSize">13.5</x:Double>
      <x:Double x:Key="TabItemMinHeight">34</x:Double>

      <!-- Accent-leak Fluent brushes (premium-polish 3.6) are defined inside
           each theme dictionary below, where the per-variant Color.* tokens resolve. -->
    </ResourceDictionary>

  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <!-- DataGrid control themes: the split package ships its own Fluent theme; without
         this include every DataGrid has no template and draws nothing (blank tables on
         Evidence, Library, Tasks, People, Registers, Print centre — root-caused 24 Oct). -->
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

    <!-- Base typography: inherits everywhere -->
    <Style Selector="Window, UserControl">
      <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
      <Setter Property="Background" Value="{DynamicResource Brush.Paper}" />
    </Style>
    <!-- The old global lnum/tnum FontFeatures style was removed (proven a no-op: Newsreader
         draws lining, tabular figures by default, and the whole "text figures" anomaly was
         later root-caused to the global Button Height 26 shearing the tops off 28pt serif
         digits, not to any font-feature resolution). Keep it removed: a bare feature tag
         defaults to value 0, which is feature OFF, and a mis-typed collection silently
         disables shaping (that trap was observed during the removal test). -->

    <!-- ========== Type system v2 (phase 3 brief 3C, DD-43): every neighbouring pair of
         levels differs in at least two of family, size, weight, colour. Roles: serif
         display/page/detail/stat/quote; sans Display section titles + eyebrows; sans UI
         lines; mono codes. Sizes never appear inline in code-behind (DD-43). ========== -->
    <Style Selector="TextBlock.displayHero"><Setter Property="FontFamily" Value="{StaticResource Font.SerifDisplayLight}" /><Setter Property="FontSize" Value="80" /><Setter Property="LineHeight" Value="80" /><Setter Property="FontWeight" Value="Light" /><Setter Property="Foreground" Value="{DynamicResource Brush.HeroFg}" /></Style>
    <!-- title.page: serif 30/36 (aliases h1, titleLarge, serifTitle for existing markup) -->
    <Style Selector="TextBlock.h1, TextBlock.titleLarge, TextBlock.serifTitle"><Setter Property="FontFamily" Value="{StaticResource Font.Serif}" /><Setter Property="FontSize" Value="30" /><Setter Property="FontWeight" Value="Regular" /><Setter Property="LineHeight" Value="36" /><Setter Property="LetterSpacing" Value="-0.2" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <!-- title.detail: serif 22/28 (alias title2) -->
    <Style Selector="TextBlock.title2, TextBlock.titleDetail"><Setter Property="FontFamily" Value="{StaticResource Font.Serif}" /><Setter Property="FontSize" Value="22" /><Setter Property="FontWeight" Value="Regular" /><Setter Property="LineHeight" Value="28" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <!-- stat: serif 28/32; Newsreader's own lining + tabular figures (no FontFeatures needed) -->
    <Style Selector="TextBlock.stat"><Setter Property="FontFamily" Value="{StaticResource Font.Serif}" /><Setter Property="FontSize" Value="28" /><Setter Property="FontWeight" Value="Regular" /></Style>
    <Style Selector="TextBlock.serifCount"><Setter Property="FontFamily" Value="{StaticResource Font.Serif}" /><Setter Property="FontSize" Value="17" /></Style>
    <!-- title.section: sans Display cut 17/22 Semibold (aliases h2, titleSection) -->
    <Style Selector="TextBlock.h2, TextBlock.titleSection"><Setter Property="FontFamily" Value="{StaticResource Font.SansDisplay}" /><Setter Property="FontSize" Value="17" /><Setter Property="LineHeight" Value="22" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="LetterSpacing" Value="-0.1" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style Selector="TextBlock.h3"><Setter Property="FontFamily" Value="{StaticResource Font.SansDisplay}" /><Setter Property="FontSize" Value="15" /><Setter Property="LineHeight" Value="20" /><Setter Property="FontWeight" Value="Medium" /></Style>
    <!-- eyebrow: caps reserved for this role; colour applied contextually (area hue) -->
    <Style Selector="TextBlock.eyebrow"><Setter Property="FontSize" Value="11" /><Setter Property="LineHeight" Value="14" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="LetterSpacing" Value="0.9" /></Style>
    <Style Selector="TextBlock.headline"><Setter Property="FontSize" Value="13.5" /><Setter Property="LineHeight" Value="18" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style Selector="TextBlock.body"><Setter Property="FontSize" Value="13" /><Setter Property="LineHeight" Value="19" /><Setter Property="Foreground" Value="{DynamicResource Brush.Ink88}" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style Selector="TextBlock.callout, TextBlock.lead, TextBlock.small"><Setter Property="FontSize" Value="12" /><Setter Property="LineHeight" Value="16" /><Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style Selector="TextBlock.footnote"><Setter Property="FontSize" Value="11" /><Setter Property="LineHeight" Value="14" /><Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <!-- label: medium muted, sentence case now (3C kills all-caps form labels) -->
    <Style Selector="TextBlock.label"><Setter Property="FontSize" Value="11.5" /><Setter Property="LineHeight" Value="14" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" /></Style>
    <Style Selector="TextBlock.code"><Setter Property="FontFamily" Value="{StaticResource Font.Mono}" /><Setter Property="FontSize" Value="11" /><Setter Property="LineHeight" Value="14" /><Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" /></Style>
    <Style Selector="TextBlock.mono"><Setter Property="FontFamily" Value="{StaticResource Font.Mono}" /><Setter Property="FontSize" Value="12" /><Setter Property="LineHeight" Value="14" /></Style>
    <Style Selector="TextBlock.monoSm"><Setter Property="FontFamily" Value="{StaticResource Font.Mono}" /><Setter Property="FontSize" Value="11" /><Setter Property="LineHeight" Value="14" /></Style>
    <Style Selector="TextBlock.monoDate"><Setter Property="FontFamily" Value="{StaticResource Font.Mono}" /><Setter Property="FontSize" Value="12.5" /><Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" /></Style>
    <!-- quote: serif 16/24; quote.cite 11/14 sans muted -->
    <Style Selector="SelectableTextBlock.quote"><Setter Property="FontFamily" Value="{StaticResource Font.Serif}" /><Setter Property="FontSize" Value="16" /><Setter Property="LineHeight" Value="24" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style Selector="TextBlock.quoteCite"><Setter Property="FontSize" Value="11" /><Setter Property="LineHeight" Value="14" /><Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" /></Style>

    <!-- Tab headers: Fluent's TabItemHeaderFontSize default of 24 blew out the detail-page
         tabs (four oversized headers wrapped, leaving a giant orphan line). M7.2 keeps them
         compact, one line, and quiet until selected. -->
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- Buttons: rounded, compact Mac push buttons.
         Metrics per the premium-polish brief: 26pt control (28 primary), 13pt text,
         radius 6, 12pt horizontal padding. NOTE: Height is a hard pin of this global
         style — Button.ledger overrides it with NaN on purpose (28pt stat digits do not
         fit a 26pt box and the template shears their tops off); do not drop that
         override. -->
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Height" Value="26" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.ControlBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Height" Value="28" />
      <Setter Property="Background" Value="{DynamicResource Brush.Green}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Green}" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.GreenHover}" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.Green}" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.Sage}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.Sage}" />
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
    </Style>
    <Style Selector="Button.destructive">
      <Setter Property="Background" Value="{DynamicResource Brush.Alert}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.White}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Alert}" />
    </Style>
    <!-- Colour language, so action buttons read at a glance:
         primary  = filled green   — the one action that CREATES something here
         verify   = green outline  — a POSITIVE compliance claim (verify/accept), lighter than primary
         caution  = amber outline  — a CORRECTIVE action (send back, needs rework)
         destructive = filled alert red — withdrawal/removal
         everything else stays the quiet outlined default -->
    <Style Selector="Button.verify">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Green}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Green}" />
    </Style>
    <Style Selector="Button.verify:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.OkBg}" />
    </Style>
    <Style Selector="Button.verify:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.OkBg}" />
    </Style>
    <Style Selector="Button.caution">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Caution}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Caution}" />
    </Style>
    <Style Selector="Button.caution:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.CautionBg}" />
    </Style>
    <Style Selector="Button.caution:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.CautionBg}" />
    </Style>
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Green}" />
    </Style>
    <Style Selector="Button.textlink">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Green}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Phase 4 §4: segmented view switcher (Requirements, then Tasks/Registers in phase 5).
    Pill buttons, 4px apart; the active one sits on SelBg with Ink text (class .on). -->
    <Style Selector="Button.seg">
      <Setter Property="Height" Value="26" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Margin" Value="0,0,4,0" />
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.ControlBorder}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.seg:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.Sage}" />
    </Style>
    <Style Selector="Button.seg.on">
      <Setter Property="Background" Value="{DynamicResource Brush.SelBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.SelBg}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    </Style>
    <Style Selector="Button.seg.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.SelBg}" />
    </Style>
    <Style Selector="Button.seg.on:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.SelBg}" />
    </Style>
    <!-- segcell: a cell INSIDE a joined segmented control (owner item 7) — no own border or
         fill; the surrounding Border draws the outline and hairline separators sit between
         cells. Selected = SelBg fill + Ink text, same vocabulary as the pills. -->
    <Style Selector="Button.segcell">
      <Setter Property="Height" Value="24" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Padding" Value="9,0" />
      <Setter Property="CornerRadius" Value="4.5" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.segcell:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.HoverTint}" />
    </Style>
    <Style Selector="Button.segcell.on">
      <Setter Property="Background" Value="{DynamicResource Brush.SelBg}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    </Style>
    <Style Selector="Button.segcell.on:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.SelBg}" />
    </Style>
    <Style Selector="Button.segcell.on:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.SelBg}" />
    </Style>

    <!-- 3F: the toolbar filter field (Mac search look: sage fill, no border, radius 7) -->
    <Style Selector="TextBox.searchMac">
      <Setter Property="Background" Value="{DynamicResource Brush.Sage}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Height" Value="28" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Padding" Value="24,4,8,4" />
    </Style>

    <!-- 3D #3/#4: section count pill + chips (tint bg, hue text contextual) -->
    <Style Selector="Border.statPill">
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Padding" Value="7,0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.chip">
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="7,2" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.chip > TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- Today screen (24 Oct): eyebrow labels, editorial serif, hero panel text, ledger rows -->
    <Style Selector="TextBlock.heroDays"><Setter Property="FontFamily" Value="{StaticResource Font.SansDisplay}" /><Setter Property="FontSize" Value="17" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="Foreground" Value="{DynamicResource Brush.HeroFg}" /></Style>
    <Style Selector="TextBlock.heroTitle"><Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource Brush.HeroFg}" /></Style>
    <Style Selector="TextBlock.heroDate"><Setter Property="FontSize" Value="13" /><Setter Property="Opacity" Value="0.9" /><Setter Property="Foreground" Value="{DynamicResource Brush.HeroFg}" /></Style>
    <Style Selector="TextBlock.heroMeta"><Setter Property="FontSize" Value="13" /><Setter Property="Foreground" Value="{DynamicResource Brush.HeroMuted}" /></Style>
    <Style Selector="TextBlock.serifTitle"><Setter Property="FontFamily" Value="{StaticResource Font.Serif}" /><Setter Property="FontSize" Value="26" /></Style>
    <Style Selector="TextBlock.serifCount"><Setter Property="FontFamily" Value="{StaticResource Font.Serif}" /><Setter Property="FontSize" Value="17" /></Style>
    <Style Selector="TextBlock.monoDate"><Setter Property="FontFamily" Value="{StaticResource Font.Mono}" /><Setter Property="FontSize" Value="12.5" /><Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" /></Style>
    <Style Selector="Button.ledger">
      <Setter Property="Height" Value="NaN" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Button.ledger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.RowHover}" />
    </Style>

    <!-- Inputs -->
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.ControlBorder}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_Border">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Green}" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.ControlBorder}" />
      <Setter Property="Padding" Value="10,0" />
    </Style>

    <!-- Combo/date-picker focus rides the green identity too (no toolkit blue anywhere) -->
    <Style Selector="ComboBox:focus /template/ Border#PART_Border">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Green}" />
    </Style>
    <Style Selector="CalendarDatePicker">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.ControlBorder}" />
    </Style>
    <!-- Calendar day-picker glyph: Fluent's default icon rendered oversized in the settings
         rows (3F #5); cap the flyout button's icon column so the field reads like every
         other control. -->
    <Style Selector="CalendarDatePicker /template/ Button#PART_FlyoutButton">
      <Setter Property="Width" Value="18" />
      <Setter Property="FontSize" Value="11" />
    </Style>

    <Style Selector="CalendarDatePicker:focus /template/ TextBox">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Green}" />
    </Style>

    <!-- Sidebar navigation rows (grouped, premium-polish 3.3): 30pt quiet rows,
         16pt icons at 1.5 stroke, 6% ink hover, SelBg + Semibold on the active row -->
    <Style Selector="Button.navRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.navRow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.HoverTint}" />
    </Style>
    <Style Selector="Button.navRow.sel /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.SelBg}" />
    </Style>
    <Style Selector="Button.navRow.sel">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    </Style>
    <!-- Sidebar icon hue per destination (3D #1): the icon always wears its hue; the
         selected row re-inks the icon to 100% opacity and takes the hue tint as fill.
         Base rule first (Ink, 85%) so glyph rows WITHOUT a hue class (none today) and
         the code-built sidebar get a defined brush; inline brushes are banned on these
         glyphs — an inline value outranks these setters and greys every icon again. -->
    <Style Selector="Button.navRow local|LucideGlyph"><Setter Property="GlyphBrush" Value="{DynamicResource Brush.Ink}" /><Setter Property="Opacity" Value="0.85" /></Style>
    <Style Selector="Button.navRow.sel local|LucideGlyph"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="Button.navRow.hueOchre local|LucideGlyph"><Setter Property="GlyphBrush" Value="{DynamicResource Brush.Ochre}" /><Setter Property="Opacity" Value="0.85" /></Style>
    <Style Selector="Button.navRow.hueForest local|LucideGlyph"><Setter Property="GlyphBrush" Value="{DynamicResource Brush.Green}" /><Setter Property="Opacity" Value="0.85" /></Style>
    <Style Selector="Button.navRow.hueTeal local|LucideGlyph"><Setter Property="GlyphBrush" Value="{DynamicResource Brush.Teal}" /><Setter Property="Opacity" Value="0.85" /></Style>
    <Style Selector="Button.navRow.hueClay local|LucideGlyph"><Setter Property="GlyphBrush" Value="{DynamicResource Brush.Clay}" /><Setter Property="Opacity" Value="0.85" /></Style>
    <Style Selector="Button.navRow.hueUmber local|LucideGlyph"><Setter Property="GlyphBrush" Value="{DynamicResource Brush.Umber}" /><Setter Property="Opacity" Value="0.85" /></Style>
    <Style Selector="Button.navRow.hueBerry local|LucideGlyph"><Setter Property="GlyphBrush" Value="{DynamicResource Brush.Berry}" /><Setter Property="Opacity" Value="0.85" /></Style>
    <Style Selector="Button.navRow.hueViolet local|LucideGlyph"><Setter Property="GlyphBrush" Value="{DynamicResource Brush.Violet}" /><Setter Property="Opacity" Value="0.85" /></Style>
    <Style Selector="Button.navRow.hueStone local|LucideGlyph"><Setter Property="GlyphBrush" Value="{DynamicResource Brush.Stone}" /><Setter Property="Opacity" Value="0.85" /></Style>
    <Style Selector="Button.navRow.hueOchre.sel local|LucideGlyph"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="Button.navRow.hueForest.sel local|LucideGlyph"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="Button.navRow.hueTeal.sel local|LucideGlyph"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="Button.navRow.hueClay.sel local|LucideGlyph"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="Button.navRow.hueUmber.sel local|LucideGlyph"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="Button.navRow.hueBerry.sel local|LucideGlyph"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="Button.navRow.hueViolet.sel local|LucideGlyph"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="Button.navRow.hueStone.sel local|LucideGlyph"><Setter Property="Opacity" Value="1" /></Style>
    <Style Selector="Button.navRow.hueOchre.sel /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Brush.OchreTint}" /></Style>
    <Style Selector="Button.navRow.hueForest.sel /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Brush.SelBg}" /></Style>
    <Style Selector="Button.navRow.hueTeal.sel /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Brush.TealTint}" /></Style>
    <Style Selector="Button.navRow.hueClay.sel /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Brush.ClayTint}" /></Style>
    <Style Selector="Button.navRow.hueUmber.sel /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Brush.UmberTint}" /></Style>
    <Style Selector="Button.navRow.hueBerry.sel /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Brush.BerryTint}" /></Style>
    <Style Selector="Button.navRow.hueViolet.sel /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Brush.VioletTint}" /></Style>
    <Style Selector="Button.navRow.hueStone.sel /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource Brush.StoneTint}" /></Style>

    <!-- DataGrid: quiet rows, hairlines, sage selection -->
    <Style Selector="dg|DataGrid">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="RowBackground" Value="Transparent" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Brush.Divider}" />
      <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
      <Setter Property="RowHeight" Value="36" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="CanUserReorderColumns" Value="False" />
    </Style>
    <Style Selector="dg|DataGridColumnHeader">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Divider}" />
    </Style>
    <Style Selector="dg|DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="{DynamicResource Brush.RowHover}" />
    </Style>
    <Style Selector="dg|DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="{DynamicResource Brush.SelBg}" />
    </Style>
    <Style Selector="dg|DataGridRow:selected">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
    </Style>

    <!-- Status chips -->
    <!-- Mac search field look for the toolbar filter (3F #3): sage fill, no border,
         radius 7. The magnifier rides the template TextBox's left adornment. -->
    <Style Selector="TextBox.searchfield">
      <Setter Property="Background" Value="{DynamicResource Brush.Sage}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="InnerLeftContent">
        <Template>
          <local:LucideGlyph Glyph="search" GlyphSize="13" GlyphBrush="{DynamicResource Brush.Muted}" StrokeThickness="1.5" Margin="10,0,0,0" />
        </Template>
      </Setter>
    </Style>

    <!-- Keycap (3F #3): quiet 1px chip for shortcut hints next to a word. -->
    <Style Selector="Border.keycap">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Divider}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource Brush.Sage}" />
    </Style>
    <Style Selector="Border.keycap TextBlock">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Muted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.tag">
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="{DynamicResource Brush.Sage}" />
    </Style>

    <!-- Cards in XAML views -->
    <Style Selector="Border.card">
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Divider}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="BoxShadow" Value="0 1 0 0 #14000000" />
    </Style>

    <!-- Content lists (two-line rows): hover tint + sage selection -->
    <Style Selector="ListBox.list">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
      <Setter Property="SelectionMode" Value="Single,AlwaysSelected" />
    </Style>
    <Style Selector="ListBox.list ListBoxItem">
      <Setter Property="MinHeight" Value="52" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="11,9" />
      <Setter Property="Margin" Value="2,2" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ListBox.list ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.HoverTint}" />
    </Style>
    <Style Selector="ListBox.list ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.SelBg}" />
    </Style>
    <Style Selector="ListBox.list ListBoxItem:selected">
      <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <!-- Section bands (Requirements list): a banded item draws its own 40pt fill, so the
         leaf selection tint must never bleed through it; band items opt out of the sage
         selection and sit on the 4% ink hover instead (owner band spec). -->
    <Style Selector="ListBox.list ListBoxItem.band">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="MinHeight" Value="40" />
    </Style>
    <Style Selector="ListBox.list ListBoxItem.band:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.list ListBoxItem.band:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource Brush.BandHover}" />
    </Style>

    <!-- Interpretation-issue box: caution tint, themed -->
    <Style Selector="Border.issuebox">
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Background" Value="{DynamicResource Brush.CautionBg}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Caution}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12" />
    </Style>

    <!-- Result strip on work pages -->
    <Style Selector="TextBox.result">
      <Setter Property="Background" Value="{DynamicResource Brush.Sage}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
      <Setter Property="FontSize" Value="11.5" />
    </Style>

    <!-- Keyboard focus visibility: brand terracotta ring where the template exposes it -->
    <Style Selector=":is(Control):focus /template/ Border#PART_FocusVisual">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
    </Style>
  </Application.Styles>
</Application>